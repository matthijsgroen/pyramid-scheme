{
  "name": "pyramid-scheme",
  "private": true,
  "version": "0.31.5",
  "type": "module",
  "scripts": {
    "dev": "vite --port 9164",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "preview": "vite preview",
    "check-types": "tsc -b",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "generate-pwa-assets": "pwa-assets-generator",
    "generate-world": "tsx scripts/generateWorld.ts && yarn prettier --write src/data/generatedWorld.ts",
    "generate-mosaic": "tsx scripts/traceMask.ts && yarn prettier --write src/ui/atoms/mosaicPieces.generated.ts",
    "validate-world": "tsx scripts/generateWorld.ts --validate-only",
    "verify-floors": "vitest run src/app/SiteMap/worldFloorAssembly.spec.ts",
    "world-info": "tsx scripts/worldInfo.ts",
    "release": "tsx scripts/release.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{json,md,css,html}": "prettier --write"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.1",
    "immer": "^11.1.16",
    "localforage": "^1.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.7",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "keep-a-changelog": "^3.1.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "storybook": "^10.5.7",
    "svgo": "^4.0.2",
    "tsx": "^4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-core": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "resolutions": {
    "sharp": "0.34.3",
    "ws": "^8.21.0"
  },
  "packageManager": "yarn@4.18.0"
}
