{
  "name": "pyramid-scheme",
  "private": true,
  "version": "0.47.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 9164",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 17",
    "test": "vitest",
    "carve-digests": "tsx scripts/carveDigests.ts",
    "lock": "tsx scripts/lock.ts",
    "room": "tsx scripts/room.ts",
    "preview": "vite preview",
    "check-types": "tsc -b",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "generate-pwa-assets": "pwa-assets-generator",
    "generate-world": "tsx scripts/generateWorld.ts && yarn prettier --write src/data/generatedWorld.ts",
    "generate-mosaic": "tsx scripts/traceMask.ts && yarn prettier --write src/mods/mosaic/game/mosaic{Pieces,Geometry}.generated.ts",
    "generate-font": "tsx scripts/generateFont.ts && yarn prettier --write src/ui/tokens/hieroglyphFont.generated.ts",
    "generate-dummy-tiles": "tsx scripts/generateDummyTiles.ts",
    "make-seamless": "tsx scripts/makeSeamless.ts",
    "import-tile": "tsx scripts/importTile.ts",
    "import-portrait": "tsx scripts/importPortrait.ts",
    "import-panel": "tsx scripts/importPanel.ts",
    "import-camp": "tsx scripts/importCamp.ts",
    "camp-cut": "tsx scripts/campCut.ts",
    "camp-look": "tsx scripts/campLook.ts",
    "camp-layers": "tsx scripts/campLayers.ts",
    "art-census": "tsx scripts/artCensus.ts",
    "drift-mask": "tsx scripts/driftMask.ts",
    "on-floor": "node scripts/onFloorPreview.mjs",
    "cut-sheet": "tsx scripts/cutSheet.ts",
    "build-sheet": "tsx scripts/buildSheet.ts",
    "validate-world": "tsx scripts/generateWorld.ts --validate-only",
    "layout-report": "tsx scripts/layoutReport.ts",
    "carve-slack": "tsx scripts/carveSlack.ts",
    "generate-seeds": "tsx scripts/puzzleSeeds.ts generate",
    "seeds-info": "tsx scripts/puzzleSeeds.ts info",
    "verify-seeds": "tsx scripts/puzzleSeeds.ts verify",
    "verify-content": "vitest run --config vitest.verify.config.ts",
    "loot-report": "tsx scripts/lootReport.ts",
    "world-info": "tsx scripts/worldInfo.ts",
    "release": "tsx scripts/release.ts",
    "prepare": "husky",
    "tile-stats": "tsx scripts/tileStats.ts",
    "rank-colour": "tsx scripts/rankColour.ts",
    "make-arch": "tsx scripts/makeArch.ts",
    "render-prop": "${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender} -b -P scripts/renderProp.py --",
    "repaint": "tsx scripts/repaintPrompt.ts",
    "verify": "yarn lint --fix && yarn check-types && vitest run && yarn starter-freeze && yarn junior-freeze && yarn betterer",
    "starter-freeze": "vitest run --config vitest.verify.config.ts src/app/SiteMap/starterCarve.verify.ts",
    "junior-freeze": "vitest run --config vitest.verify.config.ts src/app/SiteMap/juniorCarve.verify.ts",
    "junior-freeze:record": "CARVE_RECORD=junior vitest run --config vitest.verify.config.ts src/app/SiteMap/juniorCarve.verify.ts -u",
    "betterer": "betterer --strict",
    "betterer:update": "betterer --update",
    "generate-boards": "tsx scripts/puzzleBoards.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{json,md,css,html}": "prettier --write"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.10",
    "immer": "^11.1.16",
    "localforage": "^1.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7",
    "@betterer/betterer": "^6.0.0-alpha.1",
    "@betterer/cli": "^6.0.0-alpha.1",
    "@betterer/constraints": "^6.0.0-alpha.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/noto-sans-egyptian-hieroglyphs": "^5.3.0",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "^10.5.7",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "keep-a-changelog": "^3.1.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "storybook": "^10.6.7",
    "subset-font": "^2.5.0",
    "svgo": "^4.1.0",
    "tsx": "^4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.3.7",
    "vite-plugin-babel": "^1.7.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "workbox-core": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "resolutions": {
    "sharp": "^0.35.5",
    "ws": "^8.21.0",
    "simple-git": "^4.0.1"
  },
  "packageManager": "yarn@4.18.0"
}
