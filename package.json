{
  "name": "pyramid-scheme",
  "private": true,
  "version": "0.27.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 9164",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest",
    "preview": "vite preview",
    "check-types": "tsc -b",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "generate-pwa-assets": "pwa-assets-generator",
    "generate-world": "tsx scripts/generateWorld.ts && yarn prettier --write src/data/generatedWorld.ts",
    "validate-world": "tsx scripts/generateWorld.ts --validate-only",
    "world-info": "tsx scripts/worldInfo.ts",
    "release": "tsx scripts/release.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{json,md,css,html}": "prettier --write"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "clsx": "^2.1.1",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.5",
    "immer": "^11.1.11",
    "localforage": "^1.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.6.1",
    "tailwindcss": "^4.1.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.30.1",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/babel__core": "^7",
    "@types/node": "^26.0.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react-hooks": "6.0.0-rc.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^10.4.6",
    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "keep-a-changelog": "^3.0.5",
    "lint-staged": "^17.0.8",
    "prettier": "^3.6.2",
    "sharp": "^0.35.2",
    "storybook": "^10.4.6",
    "svgo": "^4.0.1",
    "tsx": "^4.22.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.3.6",
    "vite-plugin-babel": "^1.3.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.6",
    "workbox-core": "^7.3.0",
    "workbox-window": "^7.3.0"
